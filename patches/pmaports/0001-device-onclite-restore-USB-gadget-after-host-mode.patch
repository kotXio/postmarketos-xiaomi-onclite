 # Trigger a disconnect/connect event on the client side to request a new DHCP lease.
+# Serialize this with role-change recovery and use the configfs mount created by
+# the initramfs. A secondary mount must not be removed while it still exposes
+# the live gadget tree.
 reactivate_gadget() {
-	# Mount configFS
-	mkdir -p /config
-	mount -t configfs none /config || true
+	if [ ! -r "$gadget/UDC" ]; then
+		logger -t nm-tethering "gadget unavailable, skipping reactivation"
+		return 0
+	fi
+
+	mkdir -p "${gadget_lock%/*}"
+	exec 9>"$gadget_lock"
+	flock -x 9
 
-	logger -t nm-tethering "configFS mounted"
