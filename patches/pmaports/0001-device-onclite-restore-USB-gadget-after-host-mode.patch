+	if [ -z "$udc" ]; then
+		logger -t nm-tethering "gadget unbound, skipping reactivation"
+		return 0
+	fi
 
-	# Reactivate gadget
-	udc=$(cat /config/usb_gadget/g1/UDC)
-	echo "" > /config/usb_gadget/g1/UDC
+	printf '\n' > "$gadget/UDC"
 	sleep 1
-	echo "$udc" > /config/usb_gadget/g1/UDC
+	if ! printf '%s\n' "$udc" > "$gadget/UDC"; then
+		logger -t nm-tethering "failed to reactivate gadget on $udc"
+		return 1
+	fi
 
 	logger -t nm-tethering "gadget reactivated"
-
-	# Unmount configFS
-	umount /config
-	rm -rf /config
-
-	logger -t nm-tethering "configFS unmounted"
