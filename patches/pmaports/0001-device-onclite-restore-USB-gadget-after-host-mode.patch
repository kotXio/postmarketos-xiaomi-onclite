+#!/bin/sh
+set -eu
+
+tag="postmarketos-onclite-usb-gadget"
+udc="${1:-}"
+configfs="${PMOS_USB_GADGET_CONFIGFS:-/sys/kernel/config}"
+role_file="${PMOS_USB_GADGET_ROLE_FILE:-/sys/class/usb_role/7000000.usb-role-switch/role}"
+udc_root="${PMOS_USB_GADGET_UDC_ROOT:-/sys/class/udc}"
+compatible="${PMOS_USB_GADGET_COMPATIBLE:-/proc/device-tree/compatible}"
+gadget_lock="${PMOS_USB_GADGET_LOCK:-/run/lock/postmarketos-usb-gadget.lock}"
+gadget="$configfs/usb_gadget/g1"
+
+log()
+{
+	if [ "${PMOS_USB_GADGET_TEST:-0}" = "1" ]; then
+		printf '%s: %s\n' "$tag" "$*" >&2
+	else
+		logger -t "$tag" -- "$*"
+	fi
+}
+
+is_onclite()
+{
+	[ -r "$compatible" ] &&
+		tr '\000' '\n' < "$compatible" | grep -Fxq 'xiaomi,onclite'
+}
+
+has_network_function()
+{
+	for function in ncm.usb0 rndis.usb0; do
+		link="$gadget/configs/c.1/$function"
+		if [ -L "$link" ] && [ -e "$link" ]; then
+			return 0
+		fi
+	done
+	return 1
+}
+
+if [ "$udc" != "7000000.usb" ]; then
+	log "ignoring unexpected UDC $udc"
+	exit 0
+fi
+
+if ! is_onclite; then
+	log "ignoring non-onclite device"
+	exit 0
+fi
+
+if [ ! -d "$udc_root/$udc" ]; then
+	log "UDC $udc is not present"
+	exit 0
+fi
+
+if [ ! -r "$role_file" ] || [ "$(cat "$role_file")" != "device" ]; then
+	log "USB role is not device"
+	exit 0
+fi
+
+if [ ! -r "$gadget/UDC" ] || ! has_network_function; then
+	log "gadget configuration is incomplete"
+	exit 0
+fi
+
+mkdir -p "${gadget_lock%/*}"
+exec 9>"$gadget_lock"
+flock -x 9
+
+# Recheck every transition-sensitive condition after acquiring the shared lock.
+if [ ! -d "$udc_root/$udc" ] ||
+	[ "$(cat "$role_file")" != "device" ] ||
+	! has_network_function; then
+	log "state changed before bind"
+	exit 0
+fi
+
+current_udc="$(cat "$gadget/UDC")"
+if [ "$current_udc" = "$udc" ]; then
+	exit 0
+fi
+if [ -n "$current_udc" ]; then
+	log "gadget is already bound to unexpected UDC $current_udc"
+	exit 0
+fi
+
+if ! printf '%s\n' "$udc" > "$gadget/UDC"; then
+	log "failed to bind gadget to $udc"
+	exit 1
+fi
+if [ "$(cat "$gadget/UDC")" != "$udc" ]; then
+	log "UDC readback mismatch after bind"
+	exit 1
+fi
+
+log "bound complete g1 gadget to $udc"
