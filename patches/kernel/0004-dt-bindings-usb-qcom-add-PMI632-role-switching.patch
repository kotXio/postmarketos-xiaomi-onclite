From b5541910ddbee8a4df63ec3d0a2d7690a1a5d745 Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Mon, 7 Sep 2026 11:49:22 +0300
Subject: [PATCH 04/12] dt-bindings: usb: qcom: add PMI632 role switching

Describe the connector graph used to obtain the DWC3 role switch.

Signed-off-by: Kostiantyn Andriiuk <konstantin@andriyuk.com>
---
 .../devicetree/bindings/usb/qcom,pmi632-micro-usb.yaml    | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/Documentation/devicetree/bindings/usb/qcom,pmi632-micro-usb.yaml b/Documentation/devicetree/bindings/usb/qcom,pmi632-micro-usb.yaml
index ec801bf41..4a77dafc2 100644
--- a/Documentation/devicetree/bindings/usb/qcom,pmi632-micro-usb.yaml
+++ b/Documentation/devicetree/bindings/usb/qcom,pmi632-micro-usb.yaml
@@ -10,9 +10,11 @@ maintainers:
   - Bryan O'Donoghue <bryan.odonoghue@linaro.org>
 
 description:
-  The PMI632 Type-C peripheral can be configured by firmware for a micro-USB
-  connector. In that mode its RID status and interrupt report whether the ID
-  pin is grounded. This binding describes the micro-USB use of that block.
+  The PMI632 Type-C peripheral can be configured by firmware for a
+  micro-USB connector. In that mode its RID status and interrupt report
+  whether the ID pin is grounded. The driver uses that state to select the
+  USB controller role. VBUS is optional and remains disabled when the supply
+  is absent from the board description.
 
 properties:
   compatible:
