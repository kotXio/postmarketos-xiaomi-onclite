diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 98699f32ca179..d95bbdaa431d7 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -5,6 +5,16 @@
 
 if VIDEO_DEV
 
+config VIDEO_ONCLITE_OV12A10
+	tristate "Opt-in OV12A10 first light for Xiaomi Redmi 7"
+	depends on I2C && OF && GPIOLIB && REGULATOR && COMMON_CLK
+	select V4L2_CCI_I2C
+	help
+	  Fixed 2048x1536 RAW10 rear sensor. Default off; manual run=1 only.
+	  Power is synchronous and controls stay at selected stock values.
+	  No automatic power-up at probe or runtime-PM resume.
+	  The first experiment has no AE, gain, flash or autofocus controls.
+
 comment "IR I2C driver auto-selected by 'Autoselect ancillary drivers'"
 	depends on MEDIA_SUBDRV_AUTOSELECT && I2C && RC_CORE
 
