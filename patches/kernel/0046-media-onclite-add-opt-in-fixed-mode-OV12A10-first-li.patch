+	struct clk *xclk;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *vana_enable_gpio;
+	struct regulator *dvdd;
+	struct regulator *dovdd;
+	struct regulator *vaf;
+	struct pinctrl *pins;
+	struct pinctrl_state *active;
+	struct pinctrl_state *idle;
+	/* Serialize explicit streaming and system-suspend inspection. */
+	struct mutex power_lock;
+	int old_uv;
+	unsigned long old_rate;
+	bool vio_on;
+	bool vdig_on;
+	bool vaf_on;
+	bool clock_on;
+	bool voltage_attempted;
+	bool rate_attempted;
+	bool fault;
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *analogue_gain;
+};
+
+static bool run;
+module_param(run, bool, 0400);
+MODULE_PARM_DESC(run, "Register fixed-mode rear sensor, powered only by STREAMON");
+static atomic_t attempted = ATOMIC_INIT(0);
+
+static inline struct ov12a10 *to_ov12a10(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct ov12a10, sd);
+}
