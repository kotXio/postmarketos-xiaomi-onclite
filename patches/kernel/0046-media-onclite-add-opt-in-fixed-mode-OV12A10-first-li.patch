+++ b/arch/arm64/boot/dts/qcom/sdm632-xiaomi-onclite-rear-stream.dtsi
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Copyright (c) 2026 Kostiantyn Andriiuk <konstantin@andriyuk.com> */
+
+&camss {
+	ports {
+		port@0 {
+			reg = <0>;
+			onclite_rear_phy: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&onclite_rear_sensor>;
+			};
+		};
+	};
+};
+
+&cci {
+	pinctrl-0 = <&cci0_default &cci1_default>;
+};
+
+&cci_i2c0 {
+	status = "okay";
+
+	camera@10 {
+		compatible = "xiaomi,onclite-ov12a10";
+		reg = <0x10>;
+		clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
+		vio-supply = <&pm8953_l6>;
+		vdig-supply = <&pm8953_l2>;
+		vaf-supply = <&pm8953_l17>;
+		reset-gpios = <&tlmm 40 GPIO_ACTIVE_LOW>;
+		vana-enable-gpios = <&tlmm 138 GPIO_ACTIVE_HIGH>;
+		/* No boot-time/default MCLK mux or voltage request. */
+		pinctrl-names = "active", "idle";
+		pinctrl-0 = <&camss_mclk0_default>;
+		pinctrl-1 = <&rear_stream_mclk_idle>;
+		orientation = <1>;
+		rotation = <270>;
+
+		port {
+			onclite_rear_sensor: endpoint {
+				clock-lanes = <0>;
+				data-lanes = <1 2 3 4>;
+				/* Descriptor-derived candidate, not measured link rate. */
+				link-frequencies = /bits/ 64 <580000000>;
+				remote-endpoint = <&onclite_rear_phy>;
+			};
+		};
+	};
+};
+
+&tlmm {
+	rear_stream_mclk_idle: rear-stream-mclk-idle-state {
+		pins = "gpio26";
+		function = "gpio";
+		input-enable;
+		bias-pull-down;
+		drive-strength = <2>;
+	};
+};
