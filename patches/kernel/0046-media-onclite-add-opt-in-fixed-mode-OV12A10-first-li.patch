+static int ov12a10_get_resources(struct ov12a10 *p)
+{
+	struct device *dev = p->dev;
+	int ret;
+
+	p->dovdd = devm_regulator_get(dev, "vio");
+	if (IS_ERR(p->dovdd))
+		return dev_err_probe(dev, PTR_ERR(p->dovdd), "VIO missing\n");
+	p->dvdd = devm_regulator_get(dev, "vdig");
+	if (IS_ERR(p->dvdd))
+		return dev_err_probe(dev, PTR_ERR(p->dvdd), "VDIG missing\n");
+	p->vaf = devm_regulator_get(dev, "vaf");
+	if (IS_ERR(p->vaf))
+		return dev_err_probe(dev, PTR_ERR(p->vaf), "VAF missing\n");
+	if (regulator_is_enabled(p->dvdd) != 0 ||
+	    regulator_is_enabled(p->vaf) != 0)
+		return -EBUSY;
+	p->old_uv = regulator_get_voltage(p->dvdd);
+	if (p->old_uv < 975000 || p->old_uv > OV12A10_DVDD_UV ||
+	    regulator_get_voltage(p->dovdd) != OV12A10_DOVDD_UV ||
+	    regulator_get_voltage(p->vaf) != OV12A10_VAF_UV)
+		return -EINVAL;
+	p->xclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(p->xclk))
+		return PTR_ERR(p->xclk);
+	p->old_rate = clk_get_rate(p->xclk);
+	if (p->old_rate != 19200000 && p->old_rate != OV12A10_XCLK_RATE)
+		return -EINVAL;
+	p->pins = devm_pinctrl_get(dev);
+	if (IS_ERR(p->pins))
+		return PTR_ERR(p->pins);
+	p->active = pinctrl_lookup_state(p->pins, "active");
+	if (IS_ERR(p->active))
+		return PTR_ERR(p->active);
+	p->idle = pinctrl_lookup_state(p->pins, "idle");
+	if (IS_ERR(p->idle))
+		return PTR_ERR(p->idle);
+	ret = pinctrl_select_state(p->pins, p->idle);
+	if (ret)
+		return ret;
+	p->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(p->reset_gpio))
+		return PTR_ERR(p->reset_gpio);
+	p->vana_enable_gpio = devm_gpiod_get(dev, "vana-enable", GPIOD_OUT_LOW);
+	if (IS_ERR(p->vana_enable_gpio))
+		return PTR_ERR(p->vana_enable_gpio);
+	return 0;
+}
+
+static int ov12a10_check_hwcfg(struct ov12a10 *ov12a10)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct device *dev = ov12a10->dev;
+	struct fwnode_handle *endpoint;
+	unsigned long link_freq_bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 0, 0);
+	if (!endpoint)
+		return dev_err_probe(dev, -EPROBE_DEFER,
+				     "waiting for firmware graph endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &bus_cfg);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to parse endpoint\n");
+
+	ret = v4l2_link_freq_to_bitmap(dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       ov12a10_link_freq_menu,
+				       ARRAY_SIZE(ov12a10_link_freq_menu),
+				       &link_freq_bitmap);
+	if (ret)
+		goto out;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != OV12A10_DATA_LANES) {
+		ret = dev_err_probe(dev, -EINVAL,
+				    "expected %u CSI-2 lanes, got %u\n",
+				    OV12A10_DATA_LANES,
+				    bus_cfg.bus.mipi_csi2.num_data_lanes);
+		goto out;
+	}
+
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	return ret;
+}
+
+static int ov12a10_identify(struct ov12a10 *ov12a10)
+{
+	u64 chip_id;
+	int ret;
+
+	ret = cci_read(ov12a10->regmap, OV12A10_REG_CHIP_ID, &chip_id, NULL);
+	if (ret)
+		return ret;
+
+	if (chip_id != OV12A10_CHIP_ID)
+		return dev_err_probe(ov12a10->dev, -ENXIO,
+				     "chip ID 0x%04llx, expected 0x%04x\n",
+				     chip_id, OV12A10_CHIP_ID);
+
+	return 0;
+}
+
+static void ov12a10_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov12a10 *p = to_ov12a10(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	mutex_lock(&p->power_lock);
+	if (ov12a10_dirty(p))
+		ov12a10_power_off(p);
+	mutex_unlock(&p->power_lock);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+}
+
+static int ov12a10_probe(struct i2c_client *client)
+{
+	struct device_node *bus = client->adapter->dev.of_node;
+	struct ov12a10 *p;
+	u32 master;
+	int ret;
+
+	/* Must precede all allocations, GPIO muxing, supply and clock requests. */
+	if (!run)
+		return -ENODEV;
+	if (!of_machine_is_compatible("xiaomi,onclite") ||
+	    client->addr != 0x10 || (client->flags & I2C_CLIENT_TEN) ||
+	    !bus || !of_device_is_compatible(bus->parent, "qcom,msm8953-cci") ||
+	    of_property_read_u32(bus, "reg", &master) || master != 0)
+		return -ENODEV;
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C) ||
+	    client->adapter->retries)
+		return -EOPNOTSUPP;
+	if (atomic_cmpxchg(&attempted, 0, 1))
+		return -EBUSY;
+	p = devm_kzalloc(&client->dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->dev = &client->dev;
+	mutex_init(&p->power_lock);
+	v4l2_i2c_subdev_init(&p->sd, client, &ov12a10_subdev_ops);
+	ret = ov12a10_check_hwcfg(p);
+	if (ret)
+		return ret;
+	ret = ov12a10_get_resources(p);
+	if (ret)
+		return ret;
+	p->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(p->regmap))
+		return PTR_ERR(p->regmap);
+	/* No power cycle, chip read, register setup or PCM-like open at probe. */
+	ret = ov12a10_init_controls(p);
+	if (ret)
+		return ret;
+	p->sd.state_lock = p->ctrl_handler.lock;
+	p->sd.internal_ops = &ov12a10_internal_ops;
+	p->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	p->sd.entity.ops = &ov12a10_entity_ops;
+	p->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	p->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&p->sd.entity, 1, &p->pad);
+	if (ret)
+		goto free_controls;
+	ret = v4l2_subdev_init_finalize(&p->sd);
+	if (ret)
+		goto cleanup_entity;
+	ret = v4l2_async_register_subdev_sensor(&p->sd);
+	if (ret)
+		goto cleanup_subdev;
+	dev_info(p->dev, "rear-stream registered OFF; fixed stock mode, explicit STREAMON only\n");
+	return 0;
+cleanup_subdev:
+	v4l2_subdev_cleanup(&p->sd);
+cleanup_entity:
+	media_entity_cleanup(&p->sd.entity);
+free_controls:
+	v4l2_ctrl_handler_free(&p->ctrl_handler);
+	return ret;
+}
+
+static int ov12a10_suspend(struct device *dev)
+{
+	struct ov12a10 *p = to_ov12a10(dev_get_drvdata(dev));
+	int ret;
+
+	mutex_lock(&p->power_lock);
+	/* Do not invent an untested stream restart across system suspend. */
+	ret = p->fault || ov12a10_dirty(p) ? -EBUSY : 0;
+	mutex_unlock(&p->power_lock);
+	return ret;
+}
+
+static const struct dev_pm_ops ov12a10_pm_ops = {
+	.suspend = ov12a10_suspend,
+};
+
+static const struct of_device_id ov12a10_of_match[] = {
+	{ .compatible = "xiaomi,onclite-ov12a10" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ov12a10_of_match);
+
+static struct i2c_driver ov12a10_i2c_driver = {
+	.driver = {
+		.name = "onclite-ov12a10",
+		.pm = pm_sleep_ptr(&ov12a10_pm_ops),
+		.of_match_table = ov12a10_of_match,
+		.suppress_bind_attrs = true,
+	},
+	.probe = ov12a10_probe,
+	.remove = ov12a10_remove,
+};
+module_i2c_driver(ov12a10_i2c_driver);
+
