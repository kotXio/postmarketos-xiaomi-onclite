 drivers/media/i2c/Kconfig                     |  10 +
 drivers/media/i2c/Makefile                    |   1 +
 drivers/media/i2c/onclite-ov12a10.c           | 963 ++++++++++++++++++
 6 files changed, 1037 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/sdm632-xiaomi-onclite-rear-stream.dtsi
 create mode 100644 drivers/media/i2c/onclite-ov12a10.c

