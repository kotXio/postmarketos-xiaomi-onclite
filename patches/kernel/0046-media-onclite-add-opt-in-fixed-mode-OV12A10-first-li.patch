+static int ov12a10_init_controls(struct ov12a10 *ov12a10)
+{
+	struct v4l2_ctrl_handler *handler = &ov12a10->ctrl_handler;
+	struct v4l2_fwnode_device_properties props;
+	int ret;
+
+	v4l2_ctrl_handler_init(handler, 8);
+
+	ov12a10->link_freq =
+		v4l2_ctrl_new_int_menu(handler, NULL,
+				       V4L2_CID_LINK_FREQ,
+				       ARRAY_SIZE(ov12a10_link_freq_menu) - 1,
+				       0, ov12a10_link_freq_menu);
+	if (ov12a10->link_freq)
+		ov12a10->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ov12a10->pixel_rate =
+		v4l2_ctrl_new_std(handler, NULL,
+				  V4L2_CID_PIXEL_RATE, OV12A10_PIXEL_RATE,
+				  OV12A10_PIXEL_RATE, 1, OV12A10_PIXEL_RATE);
+	if (ov12a10->pixel_rate)
+		ov12a10->pixel_rate->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ov12a10->hblank =
+		v4l2_ctrl_new_std(handler, NULL, V4L2_CID_HBLANK,
+				  OV12A10_HBLANK, OV12A10_HBLANK, 1,
+				  OV12A10_HBLANK);
+	if (ov12a10->hblank)
+		ov12a10->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ov12a10->vblank =
+		v4l2_ctrl_new_std(handler, NULL, V4L2_CID_VBLANK,
+				  OV12A10_VTS - OV12A10_HEIGHT,
+				  OV12A10_VTS - OV12A10_HEIGHT, 1,
+				  OV12A10_VTS - OV12A10_HEIGHT);
+
+	ov12a10->exposure =
+		v4l2_ctrl_new_std(handler, NULL, V4L2_CID_EXPOSURE,
+				  OV12A10_EXPOSURE_DEFAULT,
+				  OV12A10_EXPOSURE_DEFAULT,
+				  OV12A10_EXPOSURE_STEP,
+				  OV12A10_EXPOSURE_DEFAULT);
+
+	ov12a10->analogue_gain =
+		v4l2_ctrl_new_std(handler, NULL,
+				  V4L2_CID_ANALOGUE_GAIN,
+				  OV12A10_ANAL_GAIN_DEFAULT,
+				  OV12A10_ANAL_GAIN_DEFAULT,
+				  OV12A10_ANAL_GAIN_STEP,
+				  OV12A10_ANAL_GAIN_DEFAULT);
+
+	if (ov12a10->vblank)
+		ov12a10->vblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	if (ov12a10->exposure)
+		ov12a10->exposure->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	if (ov12a10->analogue_gain)
+		ov12a10->analogue_gain->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	if (handler->error) {
+		ret = handler->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(ov12a10->dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(handler, NULL,
+					      &props);
+	if (ret)
+		goto error;
+
+	ov12a10->sd.ctrl_handler = handler;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(handler);
+	return ret;
+}
+
+static void ov12a10_update_pad_format(struct v4l2_mbus_framefmt *format)
+{
+	format->width = OV12A10_WIDTH;
+	format->height = OV12A10_HEIGHT;
+	format->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	format->field = V4L2_FIELD_NONE;
+	format->colorspace = V4L2_COLORSPACE_RAW;
+	format->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	format->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	format->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int ov12a10_set_pad_format(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_format *format)
+{
+	ov12a10_update_pad_format(&format->format);
+	*v4l2_subdev_state_get_format(state, format->pad) = format->format;
+
+	return 0;
+}
+
+static int ov12a10_enum_mbus_code(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+
+	return 0;
+}
+
+static int ov12a10_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != MEDIA_BUS_FMT_SBGGR10_1X10)
+		return -EINVAL;
+
+	fse->min_width = OV12A10_WIDTH;
+	fse->max_width = OV12A10_WIDTH;
+	fse->min_height = OV12A10_HEIGHT;
+	fse->max_height = OV12A10_HEIGHT;
+
+	return 0;
+}
+
+static int ov12a10_get_selection(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_selection *sel)
+{
+	if (sel->pad)
+		return -EINVAL;
+	switch (sel->target) {
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r = (struct v4l2_rect) { 0, 0, 4112, 3088 };
+		break;
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r = (struct v4l2_rect) { 8, 8, 4096, 3072 };
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static int ov12a10_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state)
+{
+	ov12a10_update_pad_format(v4l2_subdev_state_get_format(state, 0));
+	*v4l2_subdev_state_get_crop(state, 0) =
+		(struct v4l2_rect) { 8, 8, 4096, 3072 };
+
+	return 0;
+}
