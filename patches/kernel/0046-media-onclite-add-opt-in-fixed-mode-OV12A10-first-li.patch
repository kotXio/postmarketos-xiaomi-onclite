+/* Copyright (c) 2026 Kostiantyn Andriiuk <konstantin@andriyuk.com> */
+/* Actual driver functions, also compiled by the fault-injection harness. */
+static bool ov12a10_dirty(struct ov12a10 *p)
+{
+	return p->vio_on || p->vdig_on || p->vaf_on || p->clock_on ||
+		p->voltage_attempted || p->rate_attempted;
+}
+
+static void ov12a10_fault(struct ov12a10 *p, int error)
+{
+	/* No automatic recovery/reprobe or ordinary unload after failed OFF. */
+	if (!p->fault) {
+		p->fault = true;
+		__module_get(THIS_MODULE);
+	}
+	dev_err(p->dev, "rear-stream FAULT: off/restore=%d; stop, use normal reboot\n",
+		error);
+}
+
+static int ov12a10_power_off(struct ov12a10 *p)
+{
+	int ret, error = 0;
+
+	if (p->clock_on) {
+		clk_disable_unprepare(p->xclk);
+		p->clock_on = false;
+	}
+	gpiod_set_value_cansleep(p->reset_gpio, 1);
+	usleep_range(1000, 1500);
+	ret = pinctrl_select_state(p->pins, p->idle);
+	if (ret)
+		error = ret;
+	if (p->vaf_on) {
+		ret = regulator_disable(p->vaf);
+		if (ret)
+			error = ret;
+		else
+			p->vaf_on = false;
+		usleep_range(5000, 5500);
+	}
+	if (p->vio_on) {
+		/* Only our shared L6 enable reference. Never force-disable L6. */
+		ret = regulator_disable(p->dovdd);
+		if (ret)
+			error = ret;
+		else
+			p->vio_on = false;
+	}
+	if (p->vdig_on) {
+		ret = regulator_disable(p->dvdd);
+		if (ret)
+			error = ret;
+		else
+			p->vdig_on = false;
+	}
+	gpiod_set_value_cansleep(p->vana_enable_gpio, 0);
+	ret = regulator_is_enabled(p->dvdd);
+	if (ret != 0) {
+		error = ret < 0 ? ret : -EBUSY;
+	} else if (p->voltage_attempted) {
+		ret = regulator_set_voltage(p->dvdd, p->old_uv, p->old_uv);
+		if (ret)
+			error = ret;
+		else if (regulator_get_voltage(p->dvdd) != p->old_uv)
+			error = -EIO;
+		else
+			p->voltage_attempted = false;
+	}
+	ret = regulator_is_enabled(p->vaf);
+	if (ret != 0)
+		error = ret < 0 ? ret : -EBUSY;
+	if (!p->clock_on && p->rate_attempted) {
+		ret = clk_set_rate(p->xclk, p->old_rate);
+		if (ret)
+			error = ret;
+		else if (clk_get_rate(p->xclk) != p->old_rate)
+			error = -EIO;
+		else
+			p->rate_attempted = false;
+	}
+	ret = gpiod_get_raw_value_cansleep(p->reset_gpio);
+	if (ret != 0)
+		error = ret < 0 ? ret : -EIO;
+	ret = gpiod_get_raw_value_cansleep(p->vana_enable_gpio);
+	if (ret != 0)
+		error = ret < 0 ? ret : -EIO;
+	if (ov12a10_dirty(p) && !error)
+		error = -EBUSY;
+	if (error)
+		ov12a10_fault(p, error);
+	else
+		dev_info(p->dev, "rear-stream OFF: reset/gate low, refs released, L2=%duV MCLK=%lu restored\n",
+			 p->old_uv, p->old_rate);
+	return error;
+}
+
+static int ov12a10_power_on(struct ov12a10 *p)
+{
+	int ret, off_ret;
+
+	if (p->fault || ov12a10_dirty(p))
+		return -EBUSY;
+	/* Fresh preconditions at every cycle, not only module insertion. */
+	if (regulator_is_enabled(p->dvdd) != 0 ||
+	    regulator_is_enabled(p->vaf) != 0 ||
+	    regulator_get_voltage(p->dvdd) != p->old_uv ||
+	    regulator_get_voltage(p->dovdd) != OV12A10_DOVDD_UV ||
+	    regulator_get_voltage(p->vaf) != OV12A10_VAF_UV ||
+	    clk_get_rate(p->xclk) != p->old_rate)
+		return -EBUSY;
+	/* Track even a failed request: providers can partially apply changes. */
+	p->voltage_attempted = true;
+	ret = regulator_set_voltage(p->dvdd, OV12A10_DVDD_UV,
+				    OV12A10_DVDD_UV);
+	if (ret)
+		goto off;
+	if (regulator_get_voltage(p->dvdd) != OV12A10_DVDD_UV) {
+		ret = -EIO;
+		goto off;
+	}
+	p->rate_attempted = true;
+	ret = clk_set_rate(p->xclk, OV12A10_XCLK_RATE);
+	if (ret)
+		goto off;
+	if (clk_get_rate(p->xclk) != OV12A10_XCLK_RATE) {
+		ret = -EIO;
+		goto off;
+	}
+	gpiod_set_value_cansleep(p->reset_gpio, 1);
+	/* Selected stock capture order, not the earlier ID-only sequence. */
+	gpiod_set_value_cansleep(p->vana_enable_gpio, 1);
+	ret = regulator_enable(p->dvdd);
+	if (ret)
+		goto off;
+	p->vdig_on = true;
+	usleep_range(1000, 1500);
+	ret = regulator_enable(p->dovdd);
+	if (ret)
+		goto off;
+	p->vio_on = true;
+	usleep_range(1000, 1500);
+	ret = regulator_enable(p->vaf);
+	if (ret)
+		goto off;
+	p->vaf_on = true;
+	usleep_range(1000, 1500);
+	ret = pinctrl_select_state(p->pins, p->active);
+	if (ret)
+		goto off;
+	ret = clk_prepare_enable(p->xclk);
+	if (ret)
+		goto off;
+	p->clock_on = true;
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(p->reset_gpio, 0);
+	usleep_range(1000, 1500);
+	return 0;
+off:
+	off_ret = ov12a10_power_off(p);
+	return off_ret ? off_ret : ret;
+}
+
+/* No runtime-PM resume or control write outside explicit STREAMON. */
+static int ov12a10_start(struct ov12a10 *p)
+{
+	int ret, off_ret;
+
+	ret = ov12a10_power_on(p);
+	if (ret)
+		return ret;
+	ret = ov12a10_identify(p);
+	cci_multi_reg_write(p->regmap, ov12a10_init_regs,
+			    ARRAY_SIZE(ov12a10_init_regs), &ret);
+	cci_multi_reg_write(p->regmap, ov12a10_2048x1536_regs,
+			    ARRAY_SIZE(ov12a10_2048x1536_regs), &ret);
+	cci_write(p->regmap, OV12A10_REG_MODE_SELECT,
+		  OV12A10_MODE_STREAMING, &ret);
+	if (!ret)
+		return 0;
+	/* A failed 0100=1 can still have reached hardware. Always unwind. */
+	cci_write(p->regmap, OV12A10_REG_MODE_SELECT,
+		  OV12A10_MODE_STANDBY, NULL);
+	off_ret = ov12a10_power_off(p);
+	dev_err(p->dev, "rear-stream start=%d off=%d\n", ret, off_ret);
+	return off_ret ? off_ret : ret;
+}
+
+static int ov12a10_stop(struct ov12a10 *p)
+{
+	int ret, off_ret;
+
+	if (!ov12a10_dirty(p))
+		return p->fault ? -EBUSY : 0;
+	ret = cci_write(p->regmap, OV12A10_REG_MODE_SELECT,
+			OV12A10_MODE_STANDBY, NULL);
+	off_ret = ov12a10_power_off(p);
+	if (ret)
+		dev_err(p->dev, "rear-stream standby=%d off=%d\n", ret, off_ret);
+	/* Complete physical OFF clears V4L2 streaming state even on I2C error. */
+	return off_ret;
+}
+
+static int ov12a10_enable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct ov12a10 *p = to_ov12a10(sd);
+	int ret;
+
+	mutex_lock(&p->power_lock);
+	ret = ov12a10_start(p);
+	mutex_unlock(&p->power_lock);
+	return ret;
+}
+
+static int ov12a10_disable_streams(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state, u32 pad,
+				   u64 streams_mask)
+{
+	struct ov12a10 *p = to_ov12a10(sd);
+	int ret;
+
+	mutex_lock(&p->power_lock);
+	ret = ov12a10_stop(p);
+	mutex_unlock(&p->power_lock);
+	return ret;
+}
