From 507bbe460405dc7e32b508d48392ee5491bce671 Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Fri, 11 Sep 2026 11:26:29 +0300
Subject: [PATCH 38/43] ASoC: codecs: Add AW87329 probe driver

Signed-off-by: Kostiantyn Andriiuk <konstantin@andriyuk.com>
---
 sound/soc/codecs/Kconfig   |  12 ++++
 sound/soc/codecs/Makefile  |   2 +
 sound/soc/codecs/aw87329.c | 135 +++++++++++++++++++++++++++++++++++++
 3 files changed, 149 insertions(+)
 create mode 100644 sound/soc/codecs/aw87329.c

diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index 2c4d8f6ccb30b..8a9626987343b 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -53,6 +53,7 @@ config SND_SOC_ALL_CODECS
 	imply SND_SOC_ALC5623
 	imply SND_SOC_ALC5632
 	imply SND_SOC_AUDIO_IIO_AUX
+	imply SND_SOC_AW87329
 	imply SND_SOC_AW8738
 	imply SND_SOC_AW87390
 	imply SND_SOC_AW88395
@@ -660,6 +661,17 @@ config SND_SOC_AUDIO_IIO_AUX
 	  To compile this driver as a module, choose M here: the module
 	  will be called snd-soc-audio-iio-aux.
 
+config SND_SOC_AW87329
+	tristate "Awinic AW87329 Audio Amplifier"
+	depends on I2C
+	select GPIOLIB
+	select REGMAP_I2C
+	help
+	  Enable probe support for the Awinic AW87329 analog-input audio
+	  amplifier. The initial driver verifies the I2C chip ID and leaves the
+	  amplifier disabled in hardware reset. Audio profile programming is
+	  intentionally not enabled yet.
+
 config SND_SOC_AW8738
 	tristate "Awinic AW8738 Audio Amplifier"
 	select GPIOLIB
diff --git a/sound/soc/codecs/Makefile b/sound/soc/codecs/Makefile
index 0e1345dc325ca..4367372817abb 100644
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -46,6 +46,7 @@ snd-soc-ak5386-y := ak5386.o
 snd-soc-ak5558-y := ak5558.o
 snd-soc-arizona-y := arizona.o arizona-jack.o
 snd-soc-audio-iio-aux-y := audio-iio-aux.o
+snd-soc-aw87329-y := aw87329.o
 snd-soc-aw8738-y := aw8738.o
 snd-soc-aw87390-y := aw87390.o
 snd-soc-aw88081-y := aw88081.o
@@ -484,6 +485,7 @@ obj-$(CONFIG_SND_SOC_ALC5623)    += snd-soc-alc5623.o
 obj-$(CONFIG_SND_SOC_ALC5632)	+= snd-soc-alc5632.o
 obj-$(CONFIG_SND_SOC_ARIZONA)	+= snd-soc-arizona.o
 obj-$(CONFIG_SND_SOC_AUDIO_IIO_AUX)	+= snd-soc-audio-iio-aux.o
+obj-$(CONFIG_SND_SOC_AW87329)	+= snd-soc-aw87329.o
 obj-$(CONFIG_SND_SOC_AW8738)	+= snd-soc-aw8738.o
 obj-$(CONFIG_SND_SOC_AW87390)	+= snd-soc-aw87390.o
 obj-$(CONFIG_SND_SOC_AW88081)	+= snd-soc-aw88081.o
diff --git a/sound/soc/codecs/aw87329.c b/sound/soc/codecs/aw87329.c
new file mode 100644
index 0000000000000..40f4b9c8c74ce
--- /dev/null
+++ b/sound/soc/codecs/aw87329.c
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Probe-only driver for the Awinic AW87329 analog-input audio amplifier.
+ *
+ * Copyright (c) 2026 Kostiantyn Andriiuk
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+
+#define AW87329_REG_CHIP_ID	0x00
+#define AW87329_CHIP_ID		0x39
+#define AW87329_MAX_REGISTER	0x0a
+#define AW87329_ID_RETRIES	5
+
+struct aw87329 {
+	struct gpio_desc *reset_gpio;
+	struct regmap *regmap;
+};
+
+static const struct regmap_config aw87329_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = AW87329_MAX_REGISTER,
+	.cache_type = REGCACHE_NONE,
+};
+
+static void aw87329_assert_reset(void *data)
+{
+	struct aw87329 *aw = data;
+
+	/* reset-gpios is active low, so logical 1 asserts reset. */
+	gpiod_set_value_cansleep(aw->reset_gpio, 1);
+}
+
+static int aw87329_read_chip_id(struct device *dev, struct aw87329 *aw)
+{
+	unsigned int chip_id = 0;
+	int ret = 0;
+	int i;
+
+	for (i = 0; i < AW87329_ID_RETRIES; i++) {
+		ret = regmap_read(aw->regmap, AW87329_REG_CHIP_ID, &chip_id);
+		if (!ret && chip_id == AW87329_CHIP_ID)
+			return 0;
+
+		usleep_range(2000, 2500);
+	}
+
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read chip ID\n");
+
+	dev_err(dev, "unexpected chip ID 0x%02x\n", chip_id);
+	return -ENODEV;
+}
+
+static int aw87329_i2c_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct aw87329 *aw;
+	int ret;
+
+	aw = devm_kzalloc(dev, sizeof(*aw), GFP_KERNEL);
+	if (!aw)
+		return -ENOMEM;
+
+	/* Take ownership with reset asserted before touching the I2C device. */
+	aw->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(aw->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(aw->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	ret = devm_add_action_or_reset(dev, aw87329_assert_reset, aw);
+	if (ret)
+		return ret;
+
+	aw->regmap = devm_regmap_init_i2c(client, &aw87329_regmap_config);
+	if (IS_ERR(aw->regmap))
+		return dev_err_probe(dev, PTR_ERR(aw->regmap),
+				     "failed to allocate register map\n");
+
+	i2c_set_clientdata(client, aw);
+
+	/* Match the downstream reset timing, then read only the immutable ID. */
+	usleep_range(2000, 2500);
+	gpiod_set_value_cansleep(aw->reset_gpio, 0);
+	usleep_range(2000, 2500);
+
+	ret = aw87329_read_chip_id(dev, aw);
+	aw87329_assert_reset(aw);
+	if (ret)
+		return ret;
+
+	dev_info(dev, "AW87329 chip ID 0x%02x detected; amplifier left disabled\n",
+		 AW87329_CHIP_ID);
+
+	return 0;
+}
+
+static void aw87329_i2c_shutdown(struct i2c_client *client)
+{
+	struct aw87329 *aw = i2c_get_clientdata(client);
+
+	aw87329_assert_reset(aw);
+}
+
+static const struct of_device_id aw87329_of_match[] = {
+	{ .compatible = "awinic,aw87329" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, aw87329_of_match);
+
+static const struct i2c_device_id aw87329_i2c_id[] = {
+	{ "aw87329" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, aw87329_i2c_id);
+
+static struct i2c_driver aw87329_i2c_driver = {
+	.driver = {
+		.name = "aw87329",
+		.of_match_table = aw87329_of_match,
+	},
+	.probe = aw87329_i2c_probe,
+	.shutdown = aw87329_i2c_shutdown,
+	.id_table = aw87329_i2c_id,
+};
+module_i2c_driver(aw87329_i2c_driver);
+
+MODULE_DESCRIPTION("Probe-only Awinic AW87329 amplifier driver");
+MODULE_AUTHOR("Kostiantyn Andriiuk <konstantin@andriyuk.com>");
+MODULE_LICENSE("GPL");
