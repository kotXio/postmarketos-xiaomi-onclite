From 359c57bbed6029012fa5aa122e1de9b3cacdbcae Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Mon, 14 Sep 2026 12:27:26 +0300
Subject: [PATCH 48/49] media: onclite: ov12a10: add load-only full resolution

Keep the ordinary 2048x1536 default and all synchronous power/fault
unwind unchanged. Manual full_resolution=1 selects a fixed 4096x3072
RAW10 mode derived from the public GPL vince mode with three privately
verified onclite scalar differences. Expose matching fixed blanking and
exposure controls. No runtime mode switching, AE, gain, PLL, board-power,
OTP, autofocus or flash changes. Physical full-mode acceptance pending.

Signed-off-by: Kostiantyn Andriiuk <konstantin@andriyuk.com>
---
 .../media/i2c/xiaomi,onclite-ov12a10.yaml     |  5 +-
 drivers/media/i2c/Kconfig                     |  3 +-
 drivers/media/i2c/onclite-ov12a10.c           | 74 +++++++++++++++++--
 3 files changed, 71 insertions(+), 11 deletions(-)

diff --git a/Documentation/devicetree/bindings/media/i2c/xiaomi,onclite-ov12a10.yaml b/Documentation/devicetree/bindings/media/i2c/xiaomi,onclite-ov12a10.yaml
index 51f870765cd18..1b9b29889103b 100644
--- a/Documentation/devicetree/bindings/media/i2c/xiaomi,onclite-ov12a10.yaml
+++ b/Documentation/devicetree/bindings/media/i2c/xiaomi,onclite-ov12a10.yaml
@@ -10,8 +10,9 @@ maintainers:
   - Kostiantyn Andriiuk <konstantin@andriyuk.com>
 
 description: |
-  Board-specific opt-in fixed 2048x1536 RAW10 first-light experiment. Register
-  the sensor only with manual run=1. Explicit STREAMON uses stock MCLK0 24 MHz,
+  Board-specific opt-in RAW10 experiment. Default fixed 2048x1536; optional
+  full_resolution=1 selects fixed 4096x3072 only at module load. Register only
+  with manual run=1. Explicit STREAMON uses stock MCLK0 24 MHz,
   reset40, analog gate138, shared L6 1.8 V, L2 1.175 V and L17 2.85 V. No L22
   AVDD consumer, OTP, EEPROM, actuator, flash or exposure/gain writes outside
   the selected stock tables. STREAMOFF synchronously restores off-state L2
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index d95bbdaa431d7..1ceaaac2ddcfa 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -10,7 +10,8 @@ config VIDEO_ONCLITE_OV12A10
 	depends on I2C && OF && GPIOLIB && REGULATOR && COMMON_CLK
 	select V4L2_CCI_I2C
 	help
-	  Fixed 2048x1536 RAW10 rear sensor. Default off; manual run=1 only.
+	  RAW10 rear sensor. Default off; manual run=1 only, fixed 2048x1536.
+	  Optional full_resolution=1 selects fixed 4096x3072 at module load.
 	  Power is synchronous and controls stay at selected stock values.
 	  No automatic power-up at probe or runtime-PM resume.
 	  The first experiment has no AE, gain, flash or autofocus controls.
diff --git a/drivers/media/i2c/onclite-ov12a10.c b/drivers/media/i2c/onclite-ov12a10.c
index 0fc4fbca03300..c3ab96dbb07cd 100644
--- a/drivers/media/i2c/onclite-ov12a10.c
+++ b/drivers/media/i2c/onclite-ov12a10.c
@@ -1,7 +1,8 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
  * Opt-in, fixed-mode OV12A10 first-light driver for Xiaomi onclite.
- * Based on the public GPL vince one-mode driver by Kostiantyn Andriiuk.
+ * Mode selected only at module load; ordinary default is 2048x1536.
+ * Based on the public GPL vince driver by Kostiantyn Andriiuk.
  * Selected stock init differences privately checked; no original blob/code
  * redistributed. Link/external HTS derived from descriptor, not measured.
  * No AE/gain/long-exposure, AF, EEPROM, OTP or flash controls.
@@ -30,12 +31,12 @@
 #define OV12A10_DATA_LANES		4
 #define OV12A10_BITS_PER_SAMPLE		10
 
-#define OV12A10_WIDTH			2048
-#define OV12A10_HEIGHT			1536
+#define OV12A10_WIDTH			(full_resolution ? 4096 : 2048)
+#define OV12A10_HEIGHT			(full_resolution ? 3072 : 1536)
 /* floor(1064 * 464 MHz / 108 MHz), in external pixel-rate units. */
 #define OV12A10_HTS			4571
-#define OV12A10_VTS			3346
-#define OV12A10_HBLANK			2523
+#define OV12A10_VTS			(full_resolution ? 3377 : 3346)
+#define OV12A10_HBLANK			(OV12A10_HTS - OV12A10_WIDTH)
 
 #define OV12A10_REG_CHIP_ID		CCI_REG16(0x300b)
 #define OV12A10_CHIP_ID			0x1241
@@ -44,7 +45,7 @@
 #define OV12A10_MODE_STREAMING		0x01
 
 #define OV12A10_EXPOSURE_STEP		1
-#define OV12A10_EXPOSURE_DEFAULT	1682
+#define OV12A10_EXPOSURE_DEFAULT	(full_resolution ? 2816 : 1682)
 
 #define OV12A10_ANAL_GAIN_STEP		1
 #define OV12A10_ANAL_GAIN_DEFAULT	512
@@ -92,6 +93,10 @@ static bool run;
 module_param(run, bool, 0400);
 MODULE_PARM_DESC(run, "Register fixed-mode rear sensor, powered only by STREAMON");
 static atomic_t attempted = ATOMIC_INIT(0);
+/* Immutable per load: no runtime mode or exposure/gain switching. */
+static bool full_resolution;
+module_param(full_resolution, bool, 0400);
+MODULE_PARM_DESC(full_resolution, "Select 4096x3072 RAW10 at load; default 2048x1536");
 
 static inline struct ov12a10 *to_ov12a10(struct v4l2_subdev *sd)
 {
@@ -319,6 +324,55 @@ static const struct cci_reg_sequence ov12a10_2048x1536_regs[] = {
 	{ CCI_REG8(0x3813), 0x04 },
 };
 
+/* Public GPL vince full mode, with three verified onclite scalar changes. */
+static const struct cci_reg_sequence ov12a10_4096x3072_regs[] = {
+	{ CCI_REG8(0x3642), 0x12 },
+	{ CCI_REG8(0x3666), 0x08 },
+	{ CCI_REG8(0x366b), 0x20 },
+	{ CCI_REG8(0x366c), 0xa4 },
+	{ CCI_REG8(0x366d), 0x20 },
+	{ CCI_REG8(0x366e), 0xa4 },
+	{ CCI_REG8(0x3714), 0x24 },
+	{ CCI_REG8(0x371a), 0x3e },
+	{ CCI_REG8(0x3737), 0x04 },
+	{ CCI_REG8(0x3739), 0x12 },
+	{ CCI_REG8(0x37c2), 0x04 },
+	{ CCI_REG8(0x37d9), 0x0c },
+	{ CCI_REG8(0x37e3), 0x04 },
+	{ CCI_REG8(0x37e4), 0x2a },
+	{ CCI_REG8(0x37e6), 0x04 },
+	{ CCI_REG8(0x3800), 0x00 },
+	{ CCI_REG8(0x3801), 0x00 },
+	{ CCI_REG8(0x3802), 0x00 },
+	{ CCI_REG8(0x3803), 0x00 },
+	{ CCI_REG8(0x3804), 0x10 },
+	{ CCI_REG8(0x3805), 0x0f },
+	{ CCI_REG8(0x3806), 0x0c },
+	{ CCI_REG8(0x3807), 0x0f },
+	{ CCI_REG8(0x3808), 0x10 },
+	{ CCI_REG8(0x3809), 0x00 },
+	{ CCI_REG8(0x380a), 0x0c },
+	{ CCI_REG8(0x380b), 0x00 },
+	{ CCI_REG8(0x380e), 0x0d },
+	{ CCI_REG8(0x380f), 0x31 },
+	{ CCI_REG8(0x3810), 0x00 },
+	{ CCI_REG8(0x3811), 0x0a },
+	{ CCI_REG8(0x3813), 0x08 },
+	{ CCI_REG8(0x3814), 0x01 },
+	{ CCI_REG8(0x3816), 0x01 },
+	{ CCI_REG8(0x3820), 0xa8 },
+	{ CCI_REG8(0x4009), 0x0f },
+	{ CCI_REG8(0x4050), 0x04 },
+	{ CCI_REG8(0x4051), 0x0b },
+	{ CCI_REG8(0x4501), 0x00 },
+	{ CCI_REG8(0x5002), 0x45 },
+	{ CCI_REG8(0x3501), 0xb0 },
+	{ CCI_REG8(0x3502), 0x00 },
+	{ CCI_REG8(0x3820), 0xa8 },
+	{ CCI_REG8(0x3811), 0x0a },
+	{ CCI_REG8(0x3813), 0x08 },
+};
+
 static int ov12a10_init_controls(struct ov12a10 *ov12a10)
 {
 	struct v4l2_ctrl_handler *handler = &ov12a10->ctrl_handler;
@@ -655,8 +709,12 @@ static int ov12a10_start(struct ov12a10 *p)
 	ret = ov12a10_identify(p);
 	cci_multi_reg_write(p->regmap, ov12a10_init_regs,
 			    ARRAY_SIZE(ov12a10_init_regs), &ret);
-	cci_multi_reg_write(p->regmap, ov12a10_2048x1536_regs,
-			    ARRAY_SIZE(ov12a10_2048x1536_regs), &ret);
+	if (full_resolution)
+		cci_multi_reg_write(p->regmap, ov12a10_4096x3072_regs,
+				    ARRAY_SIZE(ov12a10_4096x3072_regs), &ret);
+	else
+		cci_multi_reg_write(p->regmap, ov12a10_2048x1536_regs,
+				    ARRAY_SIZE(ov12a10_2048x1536_regs), &ret);
 	cci_write(p->regmap, OV12A10_REG_MODE_SELECT,
 		  OV12A10_MODE_STREAMING, &ret);
 	if (!ret)
