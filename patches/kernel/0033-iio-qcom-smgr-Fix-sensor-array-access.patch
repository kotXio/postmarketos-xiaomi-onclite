From 84ba0852251233ef14955f38162065a6ff3bee68 Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Wed, 9 Sep 2026 18:19:24 +0300
Subject: [PATCH 33/36] iio: qcom-smgr: Fix sensor array access

Signed-off-by: Kostiantyn Andriiuk <konstantin@andriyuk.com>
---
 drivers/iio/common/qcom_smgr/qcom_smgr.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/iio/common/qcom_smgr/qcom_smgr.c b/drivers/iio/common/qcom_smgr/qcom_smgr.c
index 79d1160f7a5c3..f8ee48d075bc3 100644
--- a/drivers/iio/common/qcom_smgr/qcom_smgr.c
+++ b/drivers/iio/common/qcom_smgr/qcom_smgr.c
@@ -792,8 +792,8 @@ static int qcom_smgr_probe(struct qrtr_device *qdev)
 		}
 
 		/* Skip if sensor type is not supported */
-		if (smgr->sensors[i]->type == SNS_SMGR_SENSOR_TYPE_UNKNOWN ||
-		    !qcom_smgr_sensor_type_iio_channels[smgr->sensors[i]->type])
+		if (smgr->sensors[i].type == SNS_SMGR_SENSOR_TYPE_UNKNOWN ||
+		    !qcom_smgr_sensor_type_iio_channels[smgr->sensors[i].type])
 			continue;
 
 		ret = qcom_smgr_register_sensor(smgr, &smgr->sensors[i]);
-- 
2.43.0
