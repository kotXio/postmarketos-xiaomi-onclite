From 5c7980340f410ef3518f42362f6e5884b77f9786 Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Mon, 7 Sep 2026 11:49:22 +0300
Subject: [PATCH 01/12] dt-bindings: usb: add Qualcomm PMI632 micro-USB RID

Describe the PMI632 micro-USB RID status and interrupt resource.

The binding is opt-in and does not enable role or VBUS control.

Signed-off-by: Kostiantyn Andriiuk <konstantin@andriyuk.com>
---
 .../bindings/usb/qcom,pmi632-micro-usb.yaml   | 70 +++++++++++++++++++
 1 file changed, 70 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/usb/qcom,pmi632-micro-usb.yaml

diff --git a/Documentation/devicetree/bindings/usb/qcom,pmi632-micro-usb.yaml b/Documentation/devicetree/bindings/usb/qcom,pmi632-micro-usb.yaml
new file mode 100644
index 000000000..ec801bf41
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/qcom,pmi632-micro-usb.yaml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/qcom,pmi632-micro-usb.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm PMI632 micro-USB role detection
+
+maintainers:
+  - Bryan O'Donoghue <bryan.odonoghue@linaro.org>
+
+description:
+  The PMI632 Type-C peripheral can be configured by firmware for a micro-USB
+  connector. In that mode its RID status and interrupt report whether the ID
+  pin is grounded. This binding describes the micro-USB use of that block.
+
+properties:
+  compatible:
+    const: qcom,pmi632-micro-usb
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  interrupt-names:
+    items:
+      - const: or-rid-detect-change
+
+  connector:
+    type: object
+    $ref: /schemas/connector/usb-connector.yaml#
+    unevaluatedProperties: false
+
+  vdd-vbus-supply:
+    description: Regulator supplying 5 V to VBUS while acting as USB host.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - interrupt-names
+  - connector
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    pmic {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        usb-role-detector@1500 {
+            compatible = "qcom,pmi632-micro-usb";
+            reg = <0x1500>;
+
+            interrupts = <0x2 0x15 0x0 IRQ_TYPE_EDGE_BOTH>;
+            interrupt-names = "or-rid-detect-change";
+
+            connector {
+                compatible = "usb-b-connector";
+                label = "micro-USB";
+                type = "micro";
+            };
+        };
+    };
+...
-- 
