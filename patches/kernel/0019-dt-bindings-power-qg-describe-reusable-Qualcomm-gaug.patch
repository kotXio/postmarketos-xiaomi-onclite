---
 .../bindings/power/supply/qcom,pmi632-qg.yaml        | 12 ++++++------
 MAINTAINERS                                          |  8 ++++++++
 drivers/power/supply/{qcom_pmi632_qg.c => qcom_qg.c} |  0
 3 files changed, 14 insertions(+), 6 deletions(-)
 rename drivers/power/supply/{qcom_pmi632_qg.c => qcom_qg.c} (100%)

diff --git a/Documentation/devicetree/bindings/power/supply/qcom,pmi632-qg.yaml b/Documentation/devicetree/bindings/power/supply/qcom,pmi632-qg.yaml
index dced89eee501c..e7dd420c5d7fe 100644
--- a/Documentation/devicetree/bindings/power/supply/qcom,pmi632-qg.yaml
+++ b/Documentation/devicetree/bindings/power/supply/qcom,pmi632-qg.yaml
@@ -4,14 +4,14 @@
 $id: http://devicetree.org/schemas/power/supply/qcom,pmi632-qg.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Qualcomm PMI632 QGauge Fuel Gauge
+title: Qualcomm QGauge Fuel Gauge
 
 maintainers:
   - Marc Lainez <marc.lainez@gmail.com>
 
 description:
-  The QGauge (QG) block found in the Qualcomm PMI632 PMIC provides battery
-  fuel gauging through hardware voltage and current FIFO sampling, open
+  The QGauge (QG) block found in Qualcomm PMICs such as PMI632 and PM6150
+  provides battery fuel gauging through hardware voltage and current FIFO sampling, open
   circuit voltage (OCV) measurement, and coulomb counting. The hardware
   has a multi-state FSM (S1-S7) that automatically transitions between
   active sampling and low-power sleep states.
@@ -21,7 +21,9 @@ allOf:
 
 properties:
   compatible:
-    const: qcom,pmi632-qg
+    enum:
+      - qcom,pm6150-qg
+      - qcom,pmi632-qg
 
   reg:
     maxItems: 1
@@ -56,8 +58,6 @@ properties:
 
   monitored-battery: true
 
-  power-supplies: true
-
 required:
   - compatible
   - reg
diff --git a/MAINTAINERS b/MAINTAINERS
