From 37e4279dce10c0b8aa0d095de8947d3d94edd139 Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Mon, 7 Sep 2026 11:49:22 +0300
Subject: [PATCH 03/12] arm64: dts: qcom: onclite: add PMI632 RID detector

Wire the verified PMI632 RID interrupt and Type-C status block.

Keep the diagnostic provider role-only and VBUS-off.

Signed-off-by: Kostiantyn Andriiuk <konstantin@andriyuk.com>
---
 .../boot/dts/qcom/sdm632-xiaomi-onclite.dts   | 24 +++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sdm632-xiaomi-onclite.dts b/arch/arm64/boot/dts/qcom/sdm632-xiaomi-onclite.dts
index 5f46bd1cc..d165f1b0c 100644
--- a/arch/arm64/boot/dts/qcom/sdm632-xiaomi-onclite.dts
+++ b/arch/arm64/boot/dts/qcom/sdm632-xiaomi-onclite.dts
@@ -321,6 +321,26 @@ pm8953_l23: l23 {
 	};
 };
 
+&pmi632_typec {
+	compatible = "qcom,pmi632-micro-usb";
+	interrupts = <0x2 0x15 0x0 IRQ_TYPE_EDGE_BOTH>;
+	interrupt-names = "or-rid-detect-change";
+	/delete-property/ vdd-vbus-supply;
+	status = "okay";
+
+	connector {
+		compatible = "usb-b-connector";
+		label = "micro-USB";
+		type = "micro";
+
+		port {
+			pmi632_hs_in: endpoint {
+				remote-endpoint = <&usb_dwc3_hs>;
+			};
+		};
+	};
+};
+
 &sdhc_1 {
 	vmmc-supply = <&pm8953_l8>;
 	vqmmc-supply = <&pm8953_l5>;
@@ -353,6 +373,10 @@ &usb3 {
 	status = "okay";
 };
 
+&usb_dwc3_hs {
+	remote-endpoint = <&pmi632_hs_in>;
+};
+
 &wcd_codec {
 	qcom,gnd-jack-type-normally-open;
 	qcom,hphl-jack-type-normally-open;
-- 
2.43.0

