# Maintainer: Kostiantyn Andriiuk <konstantin@andriyuk.com>
pkgname=sns-reg
pkgver=0.1_git20250706
pkgrel=4
_commit="4d238e5f0baba3fb77456fe2bffbf8e8f18a71a0"
pkgdesc="Qualcomm Sensor Registry server"
url="https://gitlab.com/msm8996-mainline/sns-reg"
arch="armv7 aarch64"
license="GPL-3.0-or-later"
makedepends="scons qrtr-dev argp-standalone"
subpackages="$pkgname-systemd"
depends_systemd="msm-firmware-loader-systemd"
source="
	$pkgname-$_commit.tar.gz::$url/-/archive/$_commit/$pkgname-$_commit.tar.gz
	0001-parser-Accept-C-style-registry-values.patch
	0002-parser-Store-registry-values-as-uint64_t.patch
	0003-generator-Guard-padding-registry-keys.patch
	0004-Add-MSM8953-sensor-registry-groups.patch
	0005-Make-sensor-registry-group-logging-explicit.patch
	0006-Add-runtime-stock-sensor-registry-service.patch
"
builddir="$srcdir/$pkgname-$_commit"

build() {
	scons sns-reg sns-reg-generator
}

check() {
	scons tests
	./sns-reg-registry-test
	./sns-reg-map-test
}

package() {
	install -Dm755 sns-reg "$pkgdir/usr/bin/sns-reg"
	install -Dm755 sns-reg-generator "$pkgdir/usr/bin/sns-reg-generator"
	install -Dm755 sns-reg-prepare "$pkgdir/usr/libexec/sns-reg-prepare"
	install -Dm644 LICENSE \
		"$pkgdir/usr/share/licenses/$pkgname/COPYING"
}

systemd() {
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	install -Dm644 "$builddir/sns-reg.service" \
		"$subpkgdir/usr/lib/systemd/system/sns-reg.service"
	default_systemd
}

