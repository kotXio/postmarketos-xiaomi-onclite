From 53313d2f37708031df610eff6a2f7c510be9a198 Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Sun, 13 Sep 2026 16:20:31 +0300
Subject: [PATCH 45/49] dt-bindings: media: describe onclite OV12A10 first
 light

Describe the opt-in fixed-mode rear sensor and board-specific wiring.

No default MCLK mux or global supply constraints.

Signed-off-by: Kostiantyn Andriiuk <konstantin@andriyuk.com>
---
 .../media/i2c/xiaomi,onclite-ov12a10.yaml     | 86 +++++++++++++++++++
 MAINTAINERS                                   |  5 ++
 2 files changed, 91 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/xiaomi,onclite-ov12a10.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/xiaomi,onclite-ov12a10.yaml b/Documentation/devicetree/bindings/media/i2c/xiaomi,onclite-ov12a10.yaml
new file mode 100644
index 0000000000000..01acdfb70e644
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/xiaomi,onclite-ov12a10.yaml
@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/xiaomi,onclite-ov12a10.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Experimental Xiaomi Redmi 7 OV12A10 rear camera
+
+maintainers:
+  - Kostiantyn Andriiuk <konstantin@andriyuk.com>
+
+description: |
+  Board-specific opt-in fixed 2048x1536 RAW10 first-light experiment. Register
+  the sensor only with manual run=1. Explicit STREAMON uses stock MCLK0 24 MHz,
+  reset40, analog gate138, shared L6 1.8 V, L2 1.175 V and L17 2.85 V. No L22
+  AVDD consumer, OTP, EEPROM, actuator, flash or exposure/gain writes outside
+  the selected stock tables. STREAMOFF synchronously restores off-state L2
+  voltage and clock rate. No default pinctrl or assigned clock side effects.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: xiaomi,onclite-ov12a10
+  reg:
+    maxItems: 1
+  clocks:
+    maxItems: 1
+  vio-supply:
+    description: Shared fixed 1.8 V I/O supply
+  vdig-supply:
+    description: Rear digital L2, stock 1.175 V, initially disabled
+  vaf-supply:
+    description: Fixed L17 2.85 V, initially disabled
+  reset-gpios:
+    maxItems: 1
+    description: Active-low rear sensor reset
+  vana-enable-gpios:
+    maxItems: 1
+    description: Active-high analog supply gate
+  pinctrl-names:
+    items:
+      - const: active
+      - const: idle
+  pinctrl-0: true
+  pinctrl-1: true
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    unevaluatedProperties: false
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+          clock-lanes:
+            items:
+              - const: 0
+          link-frequencies:
+            maxItems: 1
+        required:
+          - data-lanes
+          - clock-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - vio-supply
+  - vdig-supply
+  - vaf-supply
+  - reset-gpios
+  - vana-enable-gpios
+  - pinctrl-names
+  - pinctrl-0
+  - pinctrl-1
+  - port
+
+unevaluatedProperties: false
diff --git a/MAINTAINERS b/MAINTAINERS
index acd02cc496ab5..f6b6a6d584d30 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -29243,6 +29243,11 @@ S:	Maintained
 T:	git git://git.kernel.org/pub/scm/linux/kernel/git/tiwai/sound.git
 F:	sound/hda/codecs/senarytech.c
 
