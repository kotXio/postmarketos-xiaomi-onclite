From 72d4460e3ac79c0d1fc26c27df2b2d9f4c93351e Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Fri, 11 Sep 2026 13:06:36 +0300
Subject: [PATCH 42/42] arm64: dts: qcom: onclite: Route AW87329 speaker

---
 arch/arm64/boot/dts/qcom/sdm632-xiaomi-onclite.dts | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sdm632-xiaomi-onclite.dts b/arch/arm64/boot/dts/qcom/sdm632-xiaomi-onclite.dts
index 2739dc4620cef..be4f50d46d717 100644
--- a/arch/arm64/boot/dts/qcom/sdm632-xiaomi-onclite.dts
+++ b/arch/arm64/boot/dts/qcom/sdm632-xiaomi-onclite.dts
@@ -182,6 +182,8 @@ speaker_amp: amplifier@58 {
 		compatible = "awinic,aw87329";
 		reg = <0x58>;
 		reset-gpios = <&tlmm 139 GPIO_ACTIVE_LOW>;
+		sound-name-prefix = "Speaker Amp";
+		firmware-name = "aw87329_kspk.bin";
 	};
 };
 
@@ -427,6 +429,16 @@ &sdhc_2 {
 &sound_card {
 	model = "xiaomi-onclite";
 
+	widgets = "Speaker", "Speaker";
+	pin-switches = "Speaker";
+	aux-devs = <&speaker_amp>;
+	audio-routing =
+		"Speaker", "Speaker Amp OUT",
+		"Speaker Amp IN", "LINEOUT",
+		"AMIC1", "MIC BIAS External1",
+		"AMIC2", "MIC BIAS External2",
+		"AMIC3", "MIC BIAS External1";
+
 	pinctrl-0 = <&cdc_pdm_lines_act &cdc_pdm_lines_2_act &cdc_pdm_comp_lines_act>;
 	pinctrl-1 = <&cdc_pdm_lines_sus &cdc_pdm_lines_2_sus &cdc_pdm_comp_lines_sus>;
 	pinctrl-names = "default", "sleep";
-- 
2.43.0

