From 8881d8c6e6854ce810d8b317a4312e05b5706fe2 Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Fri, 11 Sep 2026 11:25:50 +0300
Subject: [PATCH 37/39] dt-bindings: sound: Add Awinic AW87329

Signed-off-by: Kostiantyn Andriiuk <konstantin@andriyuk.com>
---
 .../bindings/sound/awinic,aw87329.yaml        | 55 +++++++++++++++++++
 1 file changed, 55 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/awinic,aw87329.yaml

diff --git a/Documentation/devicetree/bindings/sound/awinic,aw87329.yaml b/Documentation/devicetree/bindings/sound/awinic,aw87329.yaml
new file mode 100644
index 0000000000000..5e14eaf5de625
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/awinic,aw87329.yaml
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/awinic,aw87329.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Awinic AW87329 Audio Amplifier
+
+maintainers:
+  - Kostiantyn Andriiuk <konstantin@andriyuk.com>
+
+description:
+  The Awinic AW87329 is an analog-input Class-K audio amplifier. It is
+  configured over I2C and provides an active-low hardware reset input.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: awinic,aw87329
+
+  reg:
+    maxItems: 1
+
+  reset-gpios:
+    description:
+      Active-low hardware reset. The amplifier is disabled while reset is
+      asserted.
+    maxItems: 1
+
+  sound-name-prefix: true
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        amplifier@58 {
+            compatible = "awinic,aw87329";
+            reg = <0x58>;
+            reset-gpios = <&tlmm 139 GPIO_ACTIVE_LOW>;
+            sound-name-prefix = "Speaker Amp";
+        };
+    };
-- 
