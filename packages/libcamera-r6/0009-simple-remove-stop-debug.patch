From 7fb2f499ea82b95801c3e5840433e5ab74beff7a Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Mon, 14 Sep 2026 15:30:02 +0300
Subject: [PATCH] libcamera: simple: Remove private stop diagnostics

Signed-off-by: Kostiantyn Andriiuk <konstantin@andriyuk.com>
---
 src/libcamera/pipeline/simple/simple.cpp | 10 ++--------
 1 file changed, 2 insertions(+), 8 deletions(-)

diff --git a/src/libcamera/pipeline/simple/simple.cpp b/src/libcamera/pipeline/simple/simple.cpp
index 0b66d63..9f0fa7a 100644
--- a/src/libcamera/pipeline/simple/simple.cpp
+++ b/src/libcamera/pipeline/simple/simple.cpp
@@ -229,14 +229,8 @@ std::vector<Request *> SimpleFrames::takeRequests()
 {
 	std::vector<Request *> requests;
 	requests.reserve(frameInfo_.size());
-	for (const auto &[frame, info] : frameInfo_) {
-		LOG(SimplePipeline, Debug)
-			<< "[DEBUG-simple-stop-v1] remaining frame=" << frame
-			<< " pendingBuffers=" << info.request->hasPendingBuffers()
-			<< " metadataRequired=" << info.metadataRequired
-			<< " metadataProcessed=" << info.metadataProcessed;
-		requests.push_back(info.request);
-	}
+	for (const auto &entry : frameInfo_)
+		requests.push_back(entry.second.request);
 	/* Late metadata must not find requests returned to the application. */
 	frameInfo_.clear();
 	return requests;
-- 
2.43.0

