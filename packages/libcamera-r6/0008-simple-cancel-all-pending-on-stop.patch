From 8b4e37a42449861db4a8dc32a02649f3176cb7b5 Mon Sep 17 00:00:00 2001
From: Kostiantyn Andriiuk <konstantin@andriyuk.com>
Date: Mon, 14 Sep 2026 14:51:24 +0300
Subject: [PATCH] libcamera: simple: Cancel metadata-only pending requests on
 stop

Signed-off-by: Kostiantyn Andriiuk <konstantin@andriyuk.com>
---
 src/libcamera/pipeline/simple/simple.cpp | 30 +++++++++++++++++++-----
 1 file changed, 24 insertions(+), 6 deletions(-)

diff --git a/src/libcamera/pipeline/simple/simple.cpp b/src/libcamera/pipeline/simple/simple.cpp
index 1daee38..0b66d63 100644
--- a/src/libcamera/pipeline/simple/simple.cpp
+++ b/src/libcamera/pipeline/simple/simple.cpp
@@ -205,7 +205,7 @@ class SimpleFrames
 public:
 	void create(Request *request, bool metadataRequested);
 	void destroy(uint32_t frame);
-	void clear();
+	std::vector<Request *> takeRequests();
 
 	SimpleFrameInfo *find(uint32_t frame);
 
@@ -225,9 +225,21 @@ void SimpleFrames::destroy(uint32_t frame)
 	frameInfo_.erase(frame);
 }
 
-void SimpleFrames::clear()
+std::vector<Request *> SimpleFrames::takeRequests()
 {
+	std::vector<Request *> requests;
+	requests.reserve(frameInfo_.size());
+	for (const auto &[frame, info] : frameInfo_) {
+		LOG(SimplePipeline, Debug)
+			<< "[DEBUG-simple-stop-v1] remaining frame=" << frame
+			<< " pendingBuffers=" << info.request->hasPendingBuffers()
+			<< " metadataRequired=" << info.metadataRequired
+			<< " metadataProcessed=" << info.metadataProcessed;
+		requests.push_back(info.request);
+	}
+	/* Late metadata must not find requests returned to the application. */
 	frameInfo_.clear();
+	return requests;
 }
 
 SimpleFrameInfo *SimpleFrames::find(uint32_t frame)
@@ -975,10 +987,17 @@ void SimpleCameraData::imageBufferReady(FrameBuffer *buffer)
 
 void SimpleCameraData::clearIncompleteRequests()
 {
-	while (!conversionQueue_.empty()) {
-		pipe()->cancelRequest(conversionQueue_.front().request);
+	/*
+	 * Requests whose buffers have completed may still await IPA metadata.
+	 * They have already left conversionQueue_, but remain in frameInfo_.
+	 * After stopping workers and capture, cancel every tracked request.
+	 * Drop conversion references first; cancelRequest() returns ownership
+	 * to the application and the Request must not be accessed afterwards.
+	 */
+	while (!conversionQueue_.empty())
 		conversionQueue_.pop();
-	}
+	for (Request *request : frameInfo_.takeRequests())
+		pipe()->cancelRequest(request);
 }
 
 void SimpleCameraData::tryCompleteRequest(Request *request)
@@ -1713,7 +1732,6 @@ void SimplePipelineHandler::stopDevice(Camera *camera)
 
 	video->bufferReady.disconnect(data, &SimpleCameraData::imageBufferReady);
 
-	data->frameInfo_.clear();
 	data->clearIncompleteRequests();
 	data->conversionBuffers_.clear();
 
-- 
